#!/bin/bash
# gitea 生命周期脚本
# start : 启动 Gitea（必要时注册并启动内置 Runner），已经运行则直接返回 0
# stop  : 先停 Runner 再优雅停止 Gitea（TERM -> 等待 -> KILL）
# status: Gitea 运行中返回 0，未运行返回 3
# log   : 打印最近日志（Gitea + Runner）

set -u

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# fnOS 自带的 git 把 git-core 放在非标准目录，补齐后 remote-https 等子命令才能找到
for d in /usr/lib/git-core /usr/libexec/git-core \
         /var/packages/git/target/libexec/git-core \
         /var/packages/git/target/share/git-core \
         /var/packages/git/target/bin; do
    [ -d "$d" ] && PATH="$PATH:$d"
done

APP_HOME="${TRIM_PKGVAR:-}"
APP_ETC="${TRIM_PKGETC:-}"
APP_DEST="${TRIM_APPDEST:-}"
HTTP_PORT="${TRIM_SERVICE_PORT:-3033}"

[ -n "$APP_HOME" ] || exit 1
[ -n "$APP_ETC" ]  || exit 1
[ -n "$APP_DEST" ] || exit 1

BIN="$APP_DEST/gitea"
CONF="$APP_ETC/app.ini"
LOG_FILE="$APP_HOME/gitea.log"
PID_FILE="$APP_HOME/gitea.pid"
HOME_DIR="${TRIM_PKGHOME:-$APP_HOME}"

RUNNER_BIN="$APP_DEST/gitea-runner"
RUNNER_DIR="$APP_HOME/runner"
RUNNER_PID="$APP_HOME/gitea-runner.pid"
RUNNER_LOG="$APP_HOME/gitea-runner.log"
RUNNER_FLAG="$APP_HOME/runner-enabled"
# 内置 Runner 的标签：工作流里 runs-on 写这些名字就能命中本机
RUNNER_LABELS="ubuntu-latest:host,ubuntu-26.04:host,ubuntu-24.04:host,ubuntu-22.04:host"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

runner_log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$RUNNER_LOG"
}

pid_alive() {
    local pid="$1" bin="${2:-$BIN}"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    if [ -r "/proc/$pid/cmdline" ]; then
        cat "/proc/$pid/cmdline" 2>/dev/null | tr '\0' ' ' | grep -qF -- "$bin" || return 1
    fi
    return 0
}

current_pid() {
    [ -r "$PID_FILE" ] || return 1
    head -n 1 "$PID_FILE" 2>/dev/null | tr -d '[:space:]'
}

is_running() {
    local pid
    pid="$(current_pid)" || return 1
    [ -n "$pid" ] || return 1
    if pid_alive "$pid"; then
        return 0
    fi
    rm -f "$PID_FILE"
    return 1
}

port_open() {
    local p="$1"
    if command -v ss >/dev/null 2>&1; then
        ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${p}\$"
    elif command -v netstat >/dev/null 2>&1; then
        netstat -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${p}\$"
    else
        return 1
    fi
}

# ---------------------------------------------------------------------------
# 内置 Gitea Runner
# ---------------------------------------------------------------------------
runner_enabled() {
    if [ -f "$RUNNER_FLAG" ] && grep -qi 'false' "$RUNNER_FLAG"; then
        return 1
    fi
    [ -x "$RUNNER_BIN" ] || return 1
    return 0
}

runner_running() {
    [ -r "$RUNNER_PID" ] || return 1
    local pid
    pid="$(head -n 1 "$RUNNER_PID" 2>/dev/null | tr -d '[:space:]')"
    pid_alive "$pid" "$RUNNER_BIN" || return 1
    return 0
}

register_runner() {
    mkdir -p "$RUNNER_DIR"
    if [ -f "$RUNNER_DIR/.runner" ]; then
        return 0
    fi

    local token="" attempt
    for attempt in 1 2 3; do
        # 注意：gitea 的 CLI 会加载 [server] 段并读取 HOME，fnOS 的包用户没有 /home，
        # 不给 HOME 会 Fatal（Failed to get home directory）导致令牌生成失败
        token="$(HOME="$HOME_DIR" GITEA_WORK_DIR="$APP_HOME" GITEA_CUSTOM="$APP_HOME/custom" \
                 "$BIN" -w "$APP_HOME" -c "$CONF" actions generate-runner-token 2>>"$RUNNER_LOG" | tail -n 1)"
        token="$(printf '%s' "$token" | tr -d '[:space:]')"
        [ -n "$token" ] && break
        runner_log_msg "生成 Runner 注册令牌失败（第 ${attempt} 次），等待后重试"
        sleep 2
    done

    if [ -z "$token" ]; then
        runner_log_msg "错误：无法生成 Runner 注册令牌（详见上方日志）"
        return 1
    fi

    runner_log_msg "注册内置 Runner（${RUNNER_LABELS}）"
    # gitea-runner 也需要 HOME（否则报 $HOME is not defined），这里统一给 TRIM_PKGHOME
    ( cd "$RUNNER_DIR" && \
      HOME="$HOME_DIR" "$RUNNER_BIN" register --no-interactive \
        --instance "http://127.0.0.1:${HTTP_PORT}/" \
        --token "$token" \
        --name "$(hostname 2>/dev/null || echo fnos)-gitea" \
        --labels "$RUNNER_LABELS" >> "$RUNNER_LOG" 2>&1 )

    if [ ! -f "$RUNNER_DIR/.runner" ]; then
        runner_log_msg "错误：Runner 注册未生成 .runner 文件（详见上方日志）"
        return 1
    fi
    return 0
}

start_runner() {
    runner_enabled || return 0

    if runner_running; then
        runner_log_msg "Runner 已在运行（pid $(head -n 1 "$RUNNER_PID" | tr -d '[:space:]')），跳过启动"
        return 0
    fi

    if [ ! -f "$RUNNER_DIR/.runner" ]; then
        if ! register_runner; then
            runner_log_msg "Runner 注册失败，本次跳过启动（Gitea 仍可正常使用）"
            return 0
        fi
    fi

    cd "$RUNNER_DIR" || return 0
    # 写一份最小的 runner 配置：显式给缓存目录，避免依赖 HOME
    if [ ! -f "$RUNNER_DIR/config.yaml" ]; then
        mkdir -p "$APP_HOME/runner-cache" "$APP_HOME/runner-work"
        cat > "$RUNNER_DIR/config.yaml" <<EOF
log:
  level: info
cache:
  enabled: true
  dir: $APP_HOME/runner-cache
host:
  workdir_parent: $APP_HOME/runner-work
EOF
    fi
    HOME="$HOME_DIR" nohup "$RUNNER_BIN" daemon >> "$RUNNER_LOG" 2>&1 &
    echo $! > "$RUNNER_PID"

    local i
    for i in $(seq 1 10); do
        sleep 1
        if runner_running; then
            runner_log_msg "Runner 已启动（pid $(head -n 1 "$RUNNER_PID" | tr -d '[:space:]')）"
            return 0
        fi
    done
    runner_log_msg "警告：Runner 未能启动，可查看 $RUNNER_LOG"
    return 0
}

stop_runner() {
    if [ ! -r "$RUNNER_PID" ]; then
        return 0
    fi
    local pid
    pid="$(head -n 1 "$RUNNER_PID" 2>/dev/null | tr -d '[:space:]')"
    if [ -n "$pid" ] && pid_alive "$pid" "$RUNNER_BIN"; then
        runner_log_msg "停止 Runner（pid $pid）"
        kill -TERM "$pid" 2>/dev/null || true
        local count=0
        while pid_alive "$pid" "$RUNNER_BIN" && [ "$count" -lt 10 ]; do
            sleep 1
            count=$((count + 1))
        done
        if pid_alive "$pid" "$RUNNER_BIN"; then
            kill -KILL "$pid" 2>/dev/null || true
        fi
    fi
    pkill -f "$RUNNER_BIN daemon" 2>/dev/null || true
    rm -f "$RUNNER_PID"
    return 0
}

# ---------------------------------------------------------------------------
# Gitea 主进程
# ---------------------------------------------------------------------------
start_process() {
    if is_running; then
        log_msg "gitea 已在运行（pid $(current_pid)），跳过启动"
        start_runner
        return 0
    fi

    if [ ! -x "$BIN" ]; then
        log_msg "错误：找不到可执行文件 $BIN"
        return 1
    fi
    if [ ! -r "$CONF" ]; then
        log_msg "错误：找不到配置文件 $CONF，请重新安装应用"
        return 1
    fi
    if port_open "$HTTP_PORT"; then
        log_msg "错误：端口 $HTTP_PORT 已被其他进程占用，无法启动"
        return 1
    fi

    mkdir -p "$APP_HOME/data" "$APP_HOME/log" "$APP_HOME/tmp" "$APP_HOME/custom/public"
    chmod 700 "$APP_HOME/custom" 2>/dev/null || true

    log_msg "启动 Gitea（端口 $HTTP_PORT，数据目录 $APP_HOME）"
    cd "$APP_HOME" || return 1
    GITEA_WORK_DIR="$APP_HOME" GITEA_CUSTOM="$APP_HOME/custom" HOME="$HOME_DIR" \
        nohup "$BIN" web -c "$CONF" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"

    # 最多等待 20 秒，确认端口已经开始监听
    local i
    for i in $(seq 1 20); do
        sleep 1
        if port_open "$HTTP_PORT"; then
            log_msg "Gitea 已启动（pid $(current_pid)，端口 $HTTP_PORT）"
            start_runner
            return 0
        fi
        if ! is_running; then
            break
        fi
    done

    if is_running && ! port_open "$HTTP_PORT"; then
        log_msg "警告：进程在运行但端口 $HTTP_PORT 未监听，请查看日志"
        start_runner
        return 0
    fi

    log_msg "错误：Gitea 启动失败，最近日志："
    tail -n 20 "$LOG_FILE" >> "$LOG_FILE" 2>/dev/null || true
    rm -f "$PID_FILE"
    return 1
}

stop_process() {
    stop_runner

    local pid
    if ! pid="$(current_pid)"; then
        log_msg "未发现 PID 文件，尝试清理残留进程"
        pkill -f "$BIN web" 2>/dev/null || true
        rm -f "$PID_FILE"
        return 0
    fi

    if ! pid_alive "$pid"; then
        rm -f "$PID_FILE"
        log_msg "进程已不存在，清理 PID 文件"
        return 0
    fi

    log_msg "停止 Gitea（pid $pid）"
    kill -TERM "$pid" 2>/dev/null || true

    local count=0
    while pid_alive "$pid" && [ "$count" -lt 20 ]; do
        sleep 1
        count=$((count + 1))
    done

    if pid_alive "$pid"; then
        log_msg "进程未在 20 秒内退出，发送 KILL"
        kill -KILL "$pid" 2>/dev/null || true
        sleep 1
    fi

    pkill -f "$BIN web" 2>/dev/null || true
    rm -f "$PID_FILE"
    log_msg "Gitea 已停止"
    return 0
}

case "${1:-}" in
start)
    start_process
    exit $?
    ;;
stop)
    stop_process
    exit $?
    ;;
status)
    if is_running; then
        echo "gitea is running (pid $(current_pid))"
        exit 0
    fi
    echo "gitea is not running"
    exit 3
    ;;
runner)
    case "${2:-}" in
    start) start_runner ;;
    stop) stop_runner ;;
    status) runner_running && exit 0 || exit 3 ;;
    *) exit 1 ;;
    esac
    exit $?
    ;;
log)
    LINES="${2:-100}"
    if [ -r "$LOG_FILE" ]; then
        tail -n "$LINES" "$LOG_FILE"
    fi
    if [ -r "$RUNNER_LOG" ]; then
        echo "=== runner ==="
        tail -n "$LINES" "$RUNNER_LOG"
    fi
    exit 0
    ;;
*)
    exit 1
    ;;
esac
