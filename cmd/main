#!/bin/bash
# gitea 生命周期脚本
# start : 启动 Gitea，已经运行则直接返回 0
# stop  : 优雅停止（TERM -> 等待 -> KILL）
# status: 运行中返回 0，未运行返回 3
# log   : 打印最近日志（可选，方便命令行排查）

set -u

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# fnOS 自带的 git 把 git-core 放在非标准目录，补齐后 remote-https 等子命令才能找到
for d in /usr/lib/git-core /usr/libexec/git-core \
         /var/packages/git/target/libexec/git-core \
         /var/packages/git/target/share/git-core \
         /var/packages/git/target/bin; do
    [ -d "$d" ] && PATH="$PATH:$d"
done

APP_HOME="${TRIM_PKGVAR:-}"
APP_ETC="${TRIM_PKGETC:-}"
APP_DEST="${TRIM_APPDEST:-}"
HTTP_PORT="${TRIM_SERVICE_PORT:-3033}"

[ -n "$APP_HOME" ] || exit 1
[ -n "$APP_ETC" ]  || exit 1
[ -n "$APP_DEST" ] || exit 1

BIN="$APP_DEST/gitea"
CONF="$APP_ETC/app.ini"
LOG_FILE="$APP_HOME/gitea.log"
PID_FILE="$APP_HOME/gitea.pid"
HOME_DIR="${TRIM_PKGHOME:-$APP_HOME}"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

pid_alive() {
    local pid="$1"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    # 防止 PID 复用：确认该进程确实是本应用的 gitea
    if [ -r "/proc/$pid/cmdline" ]; then
        tr '\0' ' ' < "/proc/$pid/cmdline" | grep -qF -- "$BIN" || return 1
    fi
    return 0
}

current_pid() {
    [ -r "$PID_FILE" ] || return 1
    head -n 1 "$PID_FILE" 2>/dev/null | tr -d '[:space:]'
}

is_running() {
    local pid
    pid="$(current_pid)" || return 1
    [ -n "$pid" ] || return 1
    if pid_alive "$pid"; then
        return 0
    fi
    rm -f "$PID_FILE"
    return 1
}

port_open() {
    local p="$1"
    if command -v ss >/dev/null 2>&1; then
        ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${p}\$"
    elif command -v netstat >/dev/null 2>&1; then
        netstat -ltn 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${p}\$"
    else
        return 1
    fi
}

start_process() {
    if is_running; then
        log_msg "gitea 已在运行（pid $(current_pid)），跳过启动"
        return 0
    fi

    if [ ! -x "$BIN" ]; then
        log_msg "错误：找不到可执行文件 $BIN"
        return 1
    fi
    if [ ! -r "$CONF" ]; then
        log_msg "错误：找不到配置文件 $CONF，请重新安装应用"
        return 1
    fi
    if port_open "$HTTP_PORT"; then
        log_msg "错误：端口 $HTTP_PORT 已被其他进程占用，无法启动"
        return 1
    fi

    mkdir -p "$APP_HOME/data" "$APP_HOME/log" "$APP_HOME/tmp" "$APP_HOME/custom/public"
    chmod 700 "$APP_HOME/custom" 2>/dev/null || true

    log_msg "启动 Gitea（端口 $HTTP_PORT，数据目录 $APP_HOME）"
    cd "$APP_HOME" || return 1
    GITEA_WORK_DIR="$APP_HOME" GITEA_CUSTOM="$APP_HOME/custom" HOME="$HOME_DIR" \
        nohup "$BIN" web -c "$CONF" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"

    # 最多等待 20 秒，确认端口已经开始监听
    local i
    for i in $(seq 1 20); do
        sleep 1
        if port_open "$HTTP_PORT"; then
            log_msg "Gitea 已启动（pid $(current_pid)，端口 $HTTP_PORT）"
            return 0
        fi
        if ! is_running; then
            break
        fi
    done

    if is_running && ! port_open "$HTTP_PORT"; then
        log_msg "警告：进程在运行但端口 $HTTP_PORT 未监听，请查看日志"
        return 0
    fi

    log_msg "错误：Gitea 启动失败，最近日志："
    tail -n 20 "$LOG_FILE" >> "$LOG_FILE" 2>/dev/null || true
    rm -f "$PID_FILE"
    return 1
}

stop_process() {
    local pid
    if ! pid="$(current_pid)"; then
        log_msg "未发现 PID 文件，尝试清理残留进程"
        pkill -f "$BIN web" 2>/dev/null || true
        rm -f "$PID_FILE"
        return 0
    fi

    if ! pid_alive "$pid"; then
        rm -f "$PID_FILE"
        log_msg "进程已不存在，清理 PID 文件"
        return 0
    fi

    log_msg "停止 Gitea（pid $pid）"
    kill -TERM "$pid" 2>/dev/null || true

    local count=0
    while pid_alive "$pid" && [ "$count" -lt 20 ]; do
        sleep 1
        count=$((count + 1))
    done

    if pid_alive "$pid"; then
        log_msg "进程未在 20 秒内退出，发送 KILL"
        kill -KILL "$pid" 2>/dev/null || true
        sleep 1
    fi

    # 兜底：清理同路径残留进程
    pkill -f "$BIN web" 2>/dev/null || true
    rm -f "$PID_FILE"
    log_msg "Gitea 已停止"
    return 0
}

case "${1:-}" in
start)
    start_process
    exit $?
    ;;
stop)
    stop_process
    exit $?
    ;;
status)
    if is_running; then
        echo "gitea is running (pid $(current_pid))"
        exit 0
    fi
    echo "gitea is not running"
    exit 3
    ;;
log)
    if [ -r "$LOG_FILE" ]; then
        tail -n "${2:-100}" "$LOG_FILE"
        exit 0
    fi
    echo "日志文件不存在: $LOG_FILE"
    exit 1
    ;;
*)
    exit 1
    ;;
esac
