[
  {
    "stepTitle": "访问地址与注册",
    "items": [
      {
        "type": "tips",
        "helpText": "如果通过域名或反向代理访问 Gitea，请把「访问地址」填写成对外地址（例如 https://git.example.com/），否则仓库地址、邮件链接会指向内网 IP。留空表示保持当前配置不变。"
      },
      {
        "type": "text",
        "field": "wizard_public_url",
        "label": "访问地址（可选）",
        "initValue": "",
        "rules": []
      },
      {
        "type": "radio",
        "field": "wizard_open_registration",
        "label": "允许访客自助注册账号",
        "initValue": "false",
        "options": [
          {
            "label": "不允许（推荐，由管理员在站内创建账号）",
            "value": "false"
          },
          {
            "label": "允许（任何人都可以注册账号）",
            "value": "true"
          }
        ]
      }
    ]
  },
  {
    "stepTitle": "邮件通知（SMTP）",
    "items": [
      {
        "type": "tips",
        "helpText": "保存后会自动重启服务。「不启用」会关闭邮件通知（参数仍保留）；「启用」时请填写完整的 SMTP 参数，密码留空表示沿用原密码。"
      },
      {
        "type": "radio",
        "field": "wizard_mail_enable",
        "label": "是否启用 SMTP 发信",
        "initValue": "false",
        "options": [
          {
            "label": "不启用（关闭邮件通知）",
            "value": "false"
          },
          {
            "label": "启用（使用下面填写的 SMTP 参数）",
            "value": "true"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_mail_host",
        "label": "SMTP 服务器地址",
        "initValue": "",
        "rules": []
      },
      {
        "type": "text",
        "field": "wizard_mail_port",
        "label": "SMTP 端口（465 为 SMTPS，587 为 STARTTLS，25 不加密）",
        "initValue": "465",
        "rules": [
          {
            "pattern": "^(|[0-9]{1,5})$",
            "message": "端口必须是数字"
          }
        ]
      },
      {
        "type": "radio",
        "field": "wizard_mail_protocol",
        "label": "加密方式",
        "initValue": "smtps",
        "options": [
          {
            "label": "SMTPS 直连（推荐，端口 465）",
            "value": "smtps"
          },
          {
            "label": "STARTTLS（端口 587）",
            "value": "smtp+starttls"
          },
          {
            "label": "不加密（端口 25，仅内网）",
            "value": "smtp"
          }
        ]
      },
      {
        "type": "radio",
        "field": "wizard_mail_skip_verify",
        "label": "跳过 TLS 证书校验（自建 SMTP 用自签名证书时选是）",
        "initValue": "false",
        "options": [
          {
            "label": "否（校验证书，推荐）",
            "value": "false"
          },
          {
            "label": "是（不校验证书）",
            "value": "true"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_mail_user",
        "label": "SMTP 用户名",
        "initValue": "",
        "rules": []
      },
      {
        "type": "password",
        "field": "wizard_mail_pass",
        "label": "SMTP 密码（留空则不改）",
        "rules": []
      },
      {
        "type": "text",
        "field": "wizard_mail_from",
        "label": "发件人地址（留空则用 SMTP 用户名）",
        "initValue": "",
        "rules": []
      }
    ]
  }
]
